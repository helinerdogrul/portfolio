{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tr/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tr/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
